node_modules/

# sma: per-run artifacts. .sma/specs/ is deliberately NOT ignored — it is the
# baseline every future run diffs against, and it belongs in version control.
.sma/changes/
.sma/impact/
.sma/prompts/
.sma/pr/
.sma/runs.json
.sma/inventory.json

# demo/demo-app is generated by `npm run demo:setup` from demo/app. It is its own
# git repo (sma fix branches it), which is why it cannot be tracked here.
demo/demo-app/
.sma/report.html

# demo/real-world/run.mjs regenerates these.
demo/real-world/watch.yaml
demo/real-world/.sma/
