{
  "name": "self-maintaining-api",
  "version": "1.0.0",
  "description": "Watch external API specs, find what they break in your repo, patch it, open a PR.",
  "keywords": [
    "openapi",
    "breaking-changes",
    "api",
    "codemod",
    "ci"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlaDrancE/self-maintaining-api.git"
  },
  "bugs": {
    "url": "https://github.com/GlaDrancE/self-maintaining-api/issues"
  },
  "homepage": "https://github.com/GlaDrancE/self-maintaining-api#readme",
  "type": "module",
  "bin": {
    "sma": "./sma.mjs"
  },
  "files": [
    "sma.mjs",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepublishOnly": "npm test",
    "test": "node --test test/*.test.mjs",
    "petstore": "node demo/petstore/server.mjs",
    "demo:setup": "node demo/setup.mjs",
    "demo:real": "node demo/real-world/run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "ts-morph": "^27.0.0",
    "yaml": "^2.8.1"
  }
}
